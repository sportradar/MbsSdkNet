diff --git a/src/Sportradar.Mbs.Sdk/Entities/Payoutmodifiersettlement/PayoutModifierSettlementBase.cs b/src/Sportradar.Mbs.Sdk/Entities/Payoutmodifiersettlement/PayoutModifierSettlementBase.cs
